# === 環境與密鑰（MCP server 以 ${VAR} 引用）===
.env
.env.local
.env.*.local

# === Claude Code 個人設定（不提交；內含 MCP 密鑰真值）===
.claude/settings.local.json

# === Angular（ng new 產生）===
/node_modules
/dist
/.angular/
# 照片的 WebP 縮圖與內容指紋，建置時由 tools/generate-image-variants.mjs 從原圖產生
/.generated/
/src/app/core/config/photo-versions.generated.json
npm-debug.log
yarn-error.log
/.idea
.DS_Store
Thumbs.db

# === 設計稿匯出的 png（可從 .pen 重新產生，單批約 14MB）===
# 保留 _index.md 與 _layout-spec.md —— 那兩份是文字、是下游對稿的依據
.claude/docs/design/exports/**/*.png

# === 攝影原始檔（每張 7～15MB，網頁只用壓縮後的版本）===
# 壓縮版進版控：src/assets/gallery/（故事書 5 張）、src/assets/weddingphotos/（婚紗藝廊 15 張）、
# hero-*.jpg、map-preview.jpg、og-share.jpg、wedding-bgm.mp3
#
# weddingphotos/ 曾經整個資料夾被忽略（當時裡面放的是原始檔）。現在它放的是縮到寬 1000 的
# 藝廊照片，是網站實際載入的檔案 —— 繼續忽略的話，GitHub Pages 上線後整個藝廊會是破圖，
# 而本機 ng serve 一切正常，不會有任何錯誤提示。別把這行加回來。
/src/assets/images/dobe-*.jpg
# 喜帖選稿用的攝影原始檔（單張 8MB 上下）。
# 網頁要用的是壓縮過的版本，例如 hero-mobile.jpg 就是從這裡的原始檔轉出來的。
/src/assets/invitationphotos/
# 喜帖匯出的圖片（單張 2MB 上下）。
# 隨時可以從網站重新截一張，不必進版控。
/exports/
# （壓縮版 groom.jpg／bride.jpg 進版控，原始檔 dobe-5329／dobe-5557 由上面那行忽略）
# 分鏡設計稿引用的原始檔副本（wedding-photo-slideshow.pen 用），同樣只留本機
/.claude/docs/design/wedding-photo/
# 輪播分鏡用的攝影原始檔（122 張、單張 10～22MB、合計約 1.3GB），理由同上
/.claude/docs/design/slideshow-photo/
/src/assets/images/map.png
/src/assets/audio/background.mp3
/src/assets/audio/background_zip.mp3
/src/assets/audio/background_2.mp3
/src/assets/audio/background_2_zip.mp3

# === Blender 角色專案（.claude/docs/data/blender/projects/）===
# .blend 單檔 13～15MB、可由 VRM＋腳本重建；source/ 是使用者的 .vroid／VRM／真人照片原檔。
# 進版控的是 project.json、costume.json、scripts/、qa/、小尺寸的 pictures/、videos/ 成品。
.claude/docs/data/blender/projects/*/*.blend
.claude/docs/data/blender/projects/*/*.blend1
.claude/docs/data/blender/projects/*/source/

# === ZEPETO 風 3D 大頭（.claude/docs/data/blender/zepeto/）===
# source/ 是使用者真人照片的副本；.blend 可由 OBJ＋postprocess.py 重建。
# 進版控的是 analysis.md、OBJ／MTL／貼圖、qa/ 驗收圖。
.claude/docs/data/blender/zepeto/*/source/
.claude/docs/data/blender/zepeto/*/*.blend
.claude/docs/data/blender/zepeto/*/*.blend1
# 可動臉（rig/）：.blend（成品 head_rig.blend、封存的舊版、中間檔，可由 AI 頭＋run_face_rig.py 重建）、
# 籠子中間檔 cage/、自動檢查的影格與報告 check/（單張臉約 40MB）不進版控；
# 進版控的是 face.json、landmarks.json、eyes.json、preview/ 的預覽圖
.claude/docs/data/blender/zepeto/*/rig/**/*.blend
.claude/docs/data/blender/zepeto/*/rig/**/*.blend1
.claude/docs/data/blender/zepeto/*/rig/cage/
.claude/docs/data/blender/zepeto/*/rig/check/
# 模板頭（templates/）：template_clean.blend、template_landmarks.json、ATTRIBUTION.md 進版控；
# source/ 是從 Sketchfab 下載的原始壓縮檔與解開的檔案，可用 API 重新下載
.claude/docs/data/blender/zepeto/templates/*/source/

# === ZEPETO 黏土風道具素材庫（.claude/docs/data/blender/library/props-zepeto/）===
# zepeto_props.blend 約 8MB，build_props.py 背景 Blender 約 20 秒重建；程式、catalog.json、資產分類檔、預覽圖進版控
.claude/docs/data/blender/library/props-zepeto/*.blend
.claude/docs/data/blender/library/props-zepeto/*.blend1
# 展示頁 index.html 圖片 base64 內嵌（約 5MB，和 previews/ 重複），發布前用 make_page.py --inline 產生（2026-10-14 使用者決定）
.claude/docs/data/blender/library/props-zepeto/index.html
# 下載的外部模型原檔（來源網址記在 external_items.py／catalog.json，可重新下載）、使用者給的參考照片（refs/<key>/analysis.md 進版控）
.claude/docs/data/blender/library/props-zepeto/external/*/source/
.claude/docs/data/blender/library/props-zepeto/refs/*/*.jpg
.claude/docs/data/blender/library/props-zepeto/refs/*/*.jpeg
.claude/docs/data/blender/library/props-zepeto/refs/*/*.png
.claude/docs/data/blender/library/props-zepeto/refs/*/*.webp

# === ZEPETO 穿戴物品素材庫（.claude/docs/data/blender/library/outfits-zepeto/）===
# outfit.py、outfit.json、catalog.json、refs/analysis.md、previews/（寬 360 小圖）進版控；
# .blend 與檢查圖在 D:/render-work/zepeto-costume，本來就不在 repo。使用者給的參考照片不進版控（含 _drafts/ 底下的試做）
.claude/docs/data/blender/library/outfits-zepeto/**/refs/*.jpg
.claude/docs/data/blender/library/outfits-zepeto/**/refs/*.jpeg
.claude/docs/data/blender/library/outfits-zepeto/**/refs/*.png
.claude/docs/data/blender/library/outfits-zepeto/**/refs/*.webp

# === Blender 製作（.claude/docs/data/blender/productions/）===
# 同框檔、整景檔（blend/couple.blend 等）可由 scripts/ 重建，單檔 30MB 上下；影格在 D:\render-work，本來就不在 repo
.claude/docs/data/blender/productions/*/**/*.blend
.claude/docs/data/blender/productions/*/**/*.blend1

# 捏臉模型與真人照片原檔（VRM 13MB、照片 9～11MB）：理由同上 source/，只有 vroid-checklist.md 進版控
.claude/docs/design/animation-photo/*.vrm
.claude/docs/design/animation-photo/*.jpg

# 開場影片動態分鏡預覽的 mp4：可用 storyboard-video-render 的 animatic.py 重產，線上預覽頁也有一份
.claude/docs/storyboard/*-animatic/*.mp4

# Python 執行時自動產生的快取
__pycache__/

# === 開場影片剪接樣式庫（.claude/docs/data/blender/library/edit-styles-zepeto/）===
# 展示頁的影片素材是樣張的低畫質預覽，build_showcase.py 從 D:/render-work 複製過來
.claude/docs/data/blender/library/edit-styles-zepeto/showcase/vid/
