                      "name": "標籤",
                      "fill": "$text-muted",
                      "content": "角色",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "icon",
                      "id": "ctWs0",
                      "name": "圖示",
                      "width": 15,
                      "height": 15,
                      "icon": "user",
                      "library": "lucide",
                      "fill": "#B8A1C9"
                    },
                    {
                      "type": "text",
                      "id": "pb9aK",
                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "新郎｜walk_fwd（往前走：從拱門左柱後走到拱門下）｜左下→中下｜高 75%｜0.8～4.0s｜朝向：右｜進場：直接｜出場：直接\n新郎｜sneak_hand（偷牽手：轉頭偷看新娘、左手悄悄伸向她，5.3s 起停住等著）｜中下｜高 75%｜4.0～6.0s｜進場：直接｜出場：直接\n新郎｜bonked（被敲抱頭：縮脖子、雙手抱頭，再揉頭傻笑）｜中下｜高 75%｜6.0～7.3s｜進場：直接｜出場：直接\n新郎｜bow（鞠躬，快速版 1.4s，鞠完站好）｜中下｜高 75%｜7.3～9.0s｜進場：直接｜出場：直接\n新娘｜walk_fwd（往前走：從拱門右柱後走到拱門下）｜右下→中下｜高 75%｜0.8～4.0s｜朝向：左｜進場：直接｜出場：直接\n新娘｜idle（站好，瞄到新郎伸來的手）｜中下｜高 75%｜4.0～4.3s｜進場：直接｜出場：直接\n新娘｜mallet_draw（從背後抽槌扛上右肩）｜中下｜高 75%｜4.3～5.0s｜進場：直接｜出場：直接\n新娘｜mallet_jump_bonk（跳起來從斜上方往下敲，6.0s 敲中，落地扛槌）｜中下｜高 75%｜5.0～7.3s｜進場：直接｜出場：直接\n新娘｜bow（鞠躬，快速版 1.4s，扛著槌）｜中下｜高 75%｜7.3～9.0s｜進場：直接｜出場：直接",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
