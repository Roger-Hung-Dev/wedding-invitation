                {
                  "type": "text",
                  "id": "qSaZm",
                  "name": "畫面描述",
                  "fill": "#33292C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "［3D 場景］花園一角（同 ② 的草地、拱門一角）的圓桌：鋪落地長桌巾（遮住坐下的蓬裙）和餐巾，桌上一大盤主餐、幾小盤點心、一盤水果，左前方一支紅酒瓶，兩只高腳杯各倒了紅酒；新郎新娘坐在相鄰兩張椅子上（約 90°、各自 3/4 對鏡頭），腰以下被桌子擋住，臉不被酒瓶、酒杯擋住；小黑板立在餐桌右側的畫架上，全程在畫面裡；鏡頭：桌前略高、全程固定；字幕 1 在兩人頭頂上方",
                  "lineHeight": 1.5,
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 14,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "s8gbTU",
                  "name": "列-字幕",
                  "width": "fill_container",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "pGU22",
                      "name": "標籤",
                      "fill": "$text-muted",
                      "content": "字幕",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "lmSGV",
                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "請大家放開胃口，／盡情享用美食（0.8～4.8s）\n【標籤】溫馨提醒（8.5～11.8s）\n【場景字・大標】喝酒不開車／開車不喝酒（小黑板，8.5～11.8s）",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
