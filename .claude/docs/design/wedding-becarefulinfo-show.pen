                {
                  "type": "text",
                  "id": "CrK4m",
                  "name": "畫面描述",
                  "fill": "#33292C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "［3D 場景］燭光晚宴桌：桌上牛排餐盤、小蛋糕、燭台、兩只水晶香檳杯；新郎新娘並肩站在桌後（桌面擋住下半身，畫面正中）；鏡頭：桌子正前方、略高於桌面；後段焦點退到前景燭火、大標從燭光中浮現；右下角金色線條計程車小圖示",
                  "lineHeight": 1.5,
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 14,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "bT5jM",
                  "name": "列-字幕",
                  "width": "fill_container",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "hJ54S",
                      "name": "標籤",
                      "fill": "$text-muted",
                      "content": "字幕",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "MlMQE",
                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "請大家放開胃口，／盡情享用美食與美酒！（0.5～4.0s）\n【標籤】溫馨提醒（4.2～9.8s）\n【大標】喝酒不開車／開車不喝酒（4.2～9.8s）\n安全第一，開心盡興！（7.0～9.8s）",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
