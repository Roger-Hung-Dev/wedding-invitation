                    },
                    {
                      "type": "text",
                      "id": "TLNOC",
                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "新郎｜新動作：舉杯乾杯（手持香檳杯，兩人在桌上方碰杯後朝鏡頭致意）｜中｜高 70%｜0～4.2s｜取景：半身｜進場：直接｜出場：直接\n新郎｜新動作：品嚐美食（叉起一口牛排、滿足點頭）｜中｜高 70%｜4.2～10.0s｜取景：半身｜進場：直接｜出場：直接\n新娘｜新動作：舉杯乾杯（手持香檳杯）｜中｜高 70%｜0～4.2s｜取景：半身｜進場：直接｜出場：直接\n新娘｜shake（搖頭，笑著提醒開車不喝酒）｜中｜高 70%｜4.2～10.0s｜取景：半身｜進場：直接｜出場：直接",
                      "lineHeight": 1.5,
