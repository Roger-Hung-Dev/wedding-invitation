                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "為了讓大家擁有／最佳的觀禮體驗（0.8～4.0s）\n請花 1 分鐘，／讀完今日的幸福守則（4.0～8.8s）",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "j8pi8k",
                  "name": "列-角色",
                  "width": "fill_container",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
