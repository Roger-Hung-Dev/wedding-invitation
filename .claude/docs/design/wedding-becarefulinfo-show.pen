                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "規矩講完了！／請準備好雙手與熱情…（0.2～3.2s）\n【場景字・大標】3 → 2 → 1（鐘樓鐘面，3.2～6.2s）\n讓我們用最熱烈的掌聲／歡迎新人登場！（6.2～9.6s）",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
