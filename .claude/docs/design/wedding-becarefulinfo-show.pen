                      "fontSize": 13,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "KHVmJ",
                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "不用迪士尼歌曲的歌詞或旋律；配樂一律原創或免版稅曲庫，只寫情緒與曲風。",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
