                      "type": "text",
                      "id": "CbO6j",
                      "name": "標籤",
                      "fill": "$text-muted",
                      "content": "3",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "M9NhS",
                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "不用仿迪士尼字體的 logo（例：Waltograph 一類的仿字）。",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
