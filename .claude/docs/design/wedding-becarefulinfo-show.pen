                      "fontSize": 13,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "hZfC3",
                      "name": "值",
                      "fill": "#33292C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "版本名稱寫風格描述，不寫品牌名；類別欄寫「迪士尼風格」。",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
