{
    "mcpServers":  {
                       "chrome-devtools":  {
                                               "type":  "stdio",
                                               "command":  "npx",
                                               "args":  [
                                                            "-y",
                                                            "chrome-devtools-mcp@1.5.0"
                                                        ]
                                           },
                       "figma-bridge":  {
                                            "type":  "stdio",
                                            "command":  "npx",
                                            "args":  [
                                                         "-y",
                                                         "@gethopp/figma-mcp-bridge"
                                                     ]
                                        },
                       "blender":  {
                                       "type":  "stdio",
                                       "command":  "uvx",
                                       "args":  [
                                                    "mcp-for-blender@2.1.3"
                                                ],
                                       "env":  {
                                                   "DISABLE_TELEMETRY":  "true"
                                               }
                                   }
                   }
}
